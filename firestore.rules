rules_version = '2';
// One cloud save per account: saves/{uid}. Only its owner can read, write or delete it.
// Every write must move the revision forward by exactly one, so two devices can never
// silently overwrite each other (the game resolves the conflict and retries).
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'ts', 'device', 'summary', 'data', 'rev', 'updated'])
          && d.rev is int && d.v is int && d.data is string && d.data.size() < 800000
          && d.rev == (resource == null ? 1 : resource.data.rev + 1);
      }
      allow read, delete: if owner();
      allow create, update: if owner() && valid();
    }
    // Leaderboards: boards/{board}/scores/{uid}. Everyone may read them; a player writes only their own entry,
    // only upward (or the same score under a new name), with the server's time, and may delete it.
    match /boards/{board}/scores/{uid} {
      function mine() { return request.auth != null && request.auth.uid == uid; }
      function entry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'score', 'hero', 'stage', 'ver', 'at'])
          && d.score is int && d.score > 0 && d.score <= 100000000
          && d.name is string && d.name.size() <= 24 && d.hero is string && d.hero.size() <= 24
          && d.stage is string && d.stage.size() <= 24 && d.ver is string && d.ver.size() <= 16
          && d.at == request.time;
      }
      function better() {
        return resource == null || request.resource.data.score > resource.data.score
          || (request.resource.data.score == resource.data.score && request.resource.data.name != resource.data.name);
      }
      allow read: if true;
      allow create, update: if mine() && entry() && better();
      allow delete: if mine();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
